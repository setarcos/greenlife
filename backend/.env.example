# 复制为 .env 后按需修改：
#   cp .env.example .env
#
# 真实密钥只放在 .env 里，.env 已在 .gitignore 中，不会被提交。

# 必需。缺失会导致启动失败。
#
# 本机开发若使用 unix socket + peer 认证（以同名系统用户运行），可写成：
#   DATABASE_URL=postgresql:///greenlife?host=/tmp
# 注意这种写法依赖 peer 认证，只在本机同用户下成立，部署时请换成 TCP + 密码：
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/greenlife

# 必需。缺失会导致启动失败。建议至少 32 字节（短于此值会打 WARN）。
# 生成方式：head -c 48 /dev/urandom | base64
JWT_SECRET=replace-me-with-a-random-secret

# 可选，默认 24。非法值会 WARN 后回落到 24 小时。
JWT_EXPIRATION_HOURS=24

# 可选，默认 127.0.0.1:8080。
SERVER_ADDRESS=127.0.0.1:8080

# 必需。缺失会导致启动失败。物种照片的存储根目录：照片按拍摄年月写到
# $UPLOAD_PATH/yyyy-mm/<uuid>.<ext>，数据库里只记这个相对路径。
#
# 运行服务的用户必须对该目录有写权限。线上由 nginx 用 `location /uploads/`
# 直接把这个目录暴露出去（alias 要指向同一个路径），前端看到的 URL 是
# /uploads/<相对路径>。
UPLOAD_PATH=/srv/greenlife/uploads
